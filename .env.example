# Matrundan environment reference
#
# Real environment values are intentionally not tracked. For local development,
# copy the relevant public-safe values to `.env.local`. In Cloudflare, configure
# browser/build variables per environment and server-only values as Worker runtime
# variables/secrets.
#
# Lovable is an optional editor/preview surface only. Its project integration must
# use Matrundan Staging for both browser and server Supabase values; never point a
# Lovable preview at Production or the legacy Lovable Cloud Supabase project.

# Public Supabase/browser configuration. These values may be exposed to the browser.
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Stable public app origin used by server integrations when Matrundan identifies
# itself externally. It is deployment configuration, not domain data or a secret.
MATRUNDAN_PUBLIC_URL="https://staging.matrundan.workers.dev"

# Client-side Geoapify map key. This value is shipped to the browser and must be
# protected with provider-side origin/referrer restrictions.
VITE_GEOAPIFY_MAPS_KEY="your-browser-restricted-map-key"

# Non-secret runtime environment label used only for logging/error redaction.
# Local development may set it here; production candidate configuration injects
# it ephemerally instead of committing runtime vars to wrangler.json.
MATRUNDAN_ENVIRONMENT="local"

# Server-only values shown here as documentation only. Configure them in the
# deployment/runtime secret store or a local ignored environment file; never in
# VITE_* variables or another committed file. Lovable preview may use the staging
# service-role only through Lovable/Supabase secret configuration; it must never be
# committed or reused from Production.
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-secret"
GEOAPIFY_API_KEY="replace-with-server-secret"
VAPID_SUBJECT="mailto:you@example.com"
VAPID_PUBLIC_KEY="replace-with-public-vapid-key"
VAPID_PRIVATE_KEY="replace-with-server-secret"
