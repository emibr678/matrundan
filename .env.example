# Matrundan environment reference
#
# `.env` is intentionally tracked because Lovable Cloud uses it for the project's
# public-safe Supabase/browser configuration. Do not put private secrets there.
# For local private overrides, use `.env.local`, which is ignored by Git.

# Lovable/public Supabase configuration. These values may be exposed to the browser.
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Client-side Geoapify map key. This value is shipped to the browser and must be
# protected with provider-side origin/referrer restrictions.
VITE_GEOAPIFY_MAPS_KEY="your-browser-restricted-map-key"

# Server-only values shown here as documentation only. Configure them in the
# deployment/runtime secret store or a local ignored environment file; never in
# the tracked `.env`, VITE_* variables, or another committed file.
SUPABASE_SERVICE_ROLE_KEY="replace-with-server-secret"
GEOAPIFY_API_KEY="replace-with-server-secret"
VAPID_SUBJECT="mailto:you@example.com"
VAPID_PUBLIC_KEY="replace-with-public-vapid-key"
VAPID_PRIVATE_KEY="replace-with-server-secret"
