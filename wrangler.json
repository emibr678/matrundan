{
  "name": "staging",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ],
  "env": {
    "staging": {
      "name": "staging",
      "workers_dev": true,
      "preview_urls": true
    },
    "prod": {
      "name": "app",
      "workers_dev": true,
      "preview_urls": false
    }
  }
}
