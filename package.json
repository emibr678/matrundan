{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "bootstrap": "bash scripts/bootstrap-agent.sh",
    "codex:setup": "bash scripts/codex-cloud-setup.sh",
    "codex:maintenance": "bash scripts/codex-cloud-maintenance.sh",
    "doctor": "bun scripts/repo-tools.mjs doctor",
    "check:shell": "bash -n scripts/*.sh",
    "check:public-readiness": "bun scripts/public-readiness-check.mjs",
    "check:release": "bun scripts/release-check.mjs",
    "check:database": "bun scripts/database-contract-check.mjs && bun scripts/visit-photo-policy-contract-check.mjs",
    "check:dead-code": "bun scripts/dead-code-check.mjs",
    "lint": "eslint .",
    "lint:changed": "bun scripts/repo-tools.mjs lint-changed",
    "format": "bun run format:changed",
    "format:changed": "bun scripts/repo-tools.mjs format-changed",
    "format:check:changed": "bun scripts/repo-tools.mjs format-changed --check",
    "format:all": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"*.{ts,js,mjs,json}\"",
    "test:unit": "bun test src",
    "typecheck": "tsc --noEmit",
    "typecheck:unit": "tsc -p tsconfig.unit.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "verify:fast": "bun run check:shell && bun run check:release && bun run check:database && bun run check:dead-code && bun run test:unit && bun run typecheck && bun run typecheck:unit && bun run typecheck:e2e && bun run build",
    "verify:changed": "bun run check:shell && bun run check:dead-code && bun run typecheck:unit && bun run typecheck:e2e && bun scripts/repo-tools.mjs verify-changed",
    "verify:agent": "bun run check:shell && bun run check:dead-code && bun run typecheck:unit && bun run typecheck:e2e && bun scripts/repo-tools.mjs verify-agent",
    "verify:full": "bun run format:check && bun run lint && bun run check:shell && bun run check:public-readiness && bun run check:release && bun run check:database && bun run check:dead-code && bun run test:unit && bun run typecheck && bun run typecheck:unit && bun run typecheck:e2e && bun run build",
    "test:mobile": "playwright test --project=mobile-chromium",
    "test:mobile:changed": "playwright test --project=mobile-chromium --pass-with-no-tests --max-failures=1 --retries=0",
    "test:map": "playwright test tests/e2e/mobile-matstallen.spec.ts --project=mobile-chromium",
    "test:map:cross-browser": "playwright test tests/e2e/mobile-matstallen.spec.ts --project=mobile-webkit --project=desktop-chromium",
    "test:visual-review": "bun run build && playwright test --config=playwright.visual.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@lovable.dev/cloud-auth-js": "^1.1.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "@tanstack/zod-adapter": "^1.167.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "maplibre-gl": "5.24.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.9.1",
    "@playwright/test": "^1.62.0",
    "@types/bun": "1.3.14",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16"
  }
}
